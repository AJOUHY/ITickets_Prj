{% extends 'base.html.twig' %}

{% block title %}Page introuvable{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-7">
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center p-5">
                        <div class="mb-4">
                            <i class="bi bi-question-circle display-1 text-muted"></i>
                        </div>
                        <h1 class="h3 fw-bold mb-3">Page introuvable</h1>
                        <p class="text-muted mb-4">
                            La ressource demandée est introuvable ou n’existe pas.
                        </p>
                        <div class="d-flex justify-content-center gap-2 flex-wrap">
                            <a href="{{ path('app_home') }}" class="btn btn-primary">Retour à l’accueil</a>
                            <a href="{{ path('app_dashboard') }}" class="btn btn-outline-secondary">Mon tableau de bord</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
