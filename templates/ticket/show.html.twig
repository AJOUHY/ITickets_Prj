{% extends 'base.html.twig' %}

{% block title %}Détails du ticket{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
            <div>
                <h2 class="fw-bold mb-1">Détails du ticket</h2>
                <p class="text-muted mb-0">{{ ticket.titre }}</p>
            </div>
            <a href="{{ path('app_dashboard_client') }}" class="btn btn-outline-secondary">Retour</a>
        </div>

        <div class="row g-4">
            <div class="col-lg-7">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <strong>Type :</strong> {{ ticket.type.value }}
                            </div>
                            <div class="col-md-6">
                                <strong>Catégorie :</strong> {{ ticket.categorie.titre }}
                            </div>
                            <div class="col-md-6">
                                <strong>Urgence :</strong> {{ ticket.urgence.value }}
                            </div>
                            <div class="col-md-6">
                                <strong>Lieu :</strong> {{ ticket.lieu.value }}
                            </div>
                            <div class="col-md-6">
                                <strong>Statut :</strong> {{ ticket.status.value }}
                            </div>
                            <div class="col-md-6">
                                <strong>Affecté à :</strong>
                                {% if ticket.affecteA %}
                                    {{ ticket.affecteA.firstName }} {{ ticket.affecteA.lastName }}
                                {% else %}
                                    <span class="text-muted">Non affecté</span>
                                {% endif %}
                            </div>
                            <div class="col-md-6">
                                <strong>Date :</strong> {{ ticket.dateCreation|date('d/m/Y H:i') }}
                            </div>
                        </div>

                        <h4 class="fw-bold">Description</h4>
                        <p class="mb-0">{{ ticket.description }}</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <h4 class="fw-bold mb-3">Ajouter un commentaire</h4>
                        {{ form_start(commentForm, {'attr': {'novalidate': 'novalidate'}}) }}
                            {{ form_row(commentForm.message, {'attr': {'class': 'form-control'}}) }}
                            <button type="submit" class="btn btn-primary w-100 mt-3">Envoyer</button>
                        {{ form_end(commentForm) }}
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 mt-4">
            <div class="card-body p-4">
                <h4 class="fw-bold mb-3">Commentaires</h4>

                {% if comments is empty %}
                    <div class="alert alert-info mb-0">Aucun commentaire pour ce ticket.</div>
                {% else %}
                    {% for comment in comments %}
                        <div class="border rounded p-3 mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong>{{ comment.user.firstName }} {{ comment.user.lastName }}</strong>
                                <small class="text-muted">{{ comment.dateCreation|date('d/m/Y H:i') }}</small>
                            </div>
                            <p class="mb-0">{{ comment.message }}</p>
                        </div>
                    {% endfor %}
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
