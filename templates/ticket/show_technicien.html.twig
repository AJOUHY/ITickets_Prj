{% extends 'base.html.twig' %}

{% block title %}Détails du ticket{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
            <div>
                <h2 class="fw-bold mb-1">Détails du ticket</h2>
                <p class="text-muted mb-0">{{ ticket.titre }}</p>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <a href="{{ path('app_dashboard_technicien') }}" class="btn btn-outline-secondary">Retour</a>
                <a href="{{ path('app_ticket_edit_status', {'id': ticket.id}) }}" class="btn btn-warning">Modifier le statut</a>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-7">
                <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                    <div class="card-body p-4">
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <strong>Client :</strong> {{ ticket.user.firstName }} {{ ticket.user.lastName }}
                            </div>
                            <div class="col-md-6">
                                <strong>Email :</strong> {{ ticket.user.email }}
                            </div>
                            <div class="col-md-6">
                                <strong>Type :</strong> {{ ticket.type.value }}
                            </div>
                            <div class="col-md-6">
                                <strong>Catégorie :</strong> {{ ticket.categorie.titre }}
                            </div>
                            <div class="col-md-6">
                                <strong>Urgence :</strong>
                                {% set urgence = ticket.urgence.value %}
                                {% if urgence == 'basse' %}
                                    <span class="badge bg-success-subtle text-success-emphasis">{{ urgence }}</span>
                                {% elseif urgence == 'moyenne' %}
                                    <span class="badge bg-info-subtle text-info-emphasis">{{ urgence }}</span>
                                {% elseif urgence == 'haute' %}
                                    <span class="badge bg-warning-subtle text-warning-emphasis">{{ urgence }}</span>
                                {% else %}
                                    <span class="badge bg-danger-subtle text-danger-emphasis">{{ urgence }}</span>
                                {% endif %}
                            </div>
                            <div class="col-md-6">
                                <strong>Lieu :</strong> {{ ticket.lieu.value }}
                            </div>
                            <div class="col-md-6">
                                <strong>Statut :</strong>
                                {% if ticket.status.value == 'OPENED' %}
                                    <span class="badge bg-primary">Ouvert</span>
                                {% elseif ticket.status.value == 'IN_PROGRESS' %}
                                    <span class="badge bg-warning text-dark">En cours</span>
                                {% elseif ticket.status.value == 'PENDING' %}
                                    <span class="badge bg-secondary">En attente</span>
                                {% elseif ticket.status.value == 'RESOLVED' %}
                                    <span class="badge bg-success">Résolu</span>
                                {% else %}
                                    <span class="badge bg-dark">Fermé</span>
                                {% endif %}
                            </div>
                            <div class="col-md-6">
                                <strong>Date :</strong> {{ ticket.dateCreation|date('d/m/Y H:i') }}
                            </div>
                        </div>

                        <h4 class="fw-bold">Description</h4>
                        <p class="mb-0">{{ ticket.description }}</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                    <div class="card-body p-4">
                        <h4 class="fw-bold mb-3">Ajouter un commentaire</h4>
                        {{ form_start(commentForm, {'attr': {'novalidate': 'novalidate'}}) }}
                            {{ form_row(commentForm.message, {'attr': {'class': 'form-control'}}) }}
                            <button type="submit" class="btn btn-primary w-100 mt-3">Envoyer</button>
                        {{ form_end(commentForm) }}
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 mt-4 rounded-4 overflow-hidden">
            <div class="card-body p-4">
                <h4 class="fw-bold mb-3">Commentaires</h4>

                {% if comments is empty %}
                    <div class="alert alert-info mb-0">Aucun commentaire pour ce ticket.</div>
                {% else %}
                    {% for comment in comments %}
                        <div class="border rounded p-3 mb-3 bg-light-subtle">
                            <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                                <strong>{{ comment.user.firstName }} {{ comment.user.lastName }}</strong>
                                <small class="text-muted">{{ comment.dateCreation|date('d/m/Y H:i') }}</small>
                            </div>
                            <p class="mb-0">{{ comment.message }}</p>
                        </div>
                    {% endfor %}
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
