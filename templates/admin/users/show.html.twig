{% extends 'base.html.twig' %}

{% block title %}Détail utilisateur{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <div>
                <h2 class="fw-bold mb-1">Détail utilisateur</h2>
                <p class="text-muted mb-0">Informations complètes du compte.</p>
            </div>
            <a href="{{ path('app_admin_users_index') }}" class="btn btn-outline-secondary">Retour</a>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-md-5">
                <div class="row g-4">
                    <div class="col-md-6">
                        <p class="text-muted mb-1">Nom</p>
                        <h5 class="fw-bold mb-3">{{ user.lastName }}</h5>
                    </div>

                    <div class="col-md-6">
                        <p class="text-muted mb-1">Prénom</p>
                        <h5 class="fw-bold mb-3">{{ user.firstName }}</h5>
                    </div>

                    <div class="col-md-6">
                        <p class="text-muted mb-1">Email</p>
                        <h5 class="fw-bold mb-3">{{ user.email }}</h5>
                    </div>

                    <div class="col-md-6">
                        <p class="text-muted mb-1">Rôle</p>
                        {% set roleLabel = user.roles[0] ?? 'ROLE_CLIENT' %}
                        {% if roleLabel == 'ROLE_ADMIN' %}
                            <span class="badge bg-danger fs-6">Admin</span>
                        {% elseif roleLabel == 'ROLE_TECHNICIEN' %}
                            <span class="badge bg-warning text-dark fs-6">Technicien</span>
                        {% else %}
                            <span class="badge bg-primary fs-6">Client</span>
                        {% endif %}
                    </div>

                    <div class="col-md-6">
                        <p class="text-muted mb-1">Date de création</p>
                        <h5 class="fw-bold mb-0">{{ user.createdAt|date('d/m/Y H:i') }}</h5>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
