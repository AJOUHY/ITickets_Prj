{% extends 'base.html.twig' %}

{% block title %}Accueil - ITicket{% endblock %}

{% block body %}
    <section class="hero-section">
        <div class="container py-5">
            <div class="row align-items-center gy-4">
                <div class="col-lg-6">
                    <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill mb-3">
                        Support IT moderne
                    </span>
                    <h1 class="display-5 fw-bold mb-3">Une solution simple pour gérer les demandes de support informatique.</h1>
                    <p class="lead text-secondary mb-4">
                        ITicket centralise les demandes clients, les incidents techniques et les interventions des techniciens dans un seul espace dédié.
                    </p>
                    <div class="d-flex flex-wrap gap-3">
                        <a href="{{ path('app_contact') }}" class="btn btn-outline-primary btn-lg">Nous contacter</a>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="hero-card shadow-lg">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="text-uppercase text-muted small fw-semibold">SLA du support</span>
                                <span class="badge bg-success">+98%</span>
                            </div>
                            <div class="stat-grid">
                                <div class="stat-box">
                                    <h3>1 250</h3>
                                    <p>Tickets traités</p>
                                </div>
                                <div class="stat-box">
                                    <h3>24/7</h3>
                                    <p>Disponibilité</p>
                                </div>
                                <div class="stat-box">
                                    <h3>3 min</h3>
                                    <p>Temps moyen de réponse</p>
                                </div>
                                <div class="stat-box">
                                    <h3>12</h3>
                                    <p>Techniciens actifs</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="py-5 bg-light">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="fw-bold">Pourquoi choisir ITicket ?</h2>
            </div>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="feature-card h-100">
                        <div class="feature-icon"><i class="bi bi-clipboard-check"></i></div>
                        <h4>Suivi des tickets</h4>
                        <p>Suivez l’état de chaque demande de support, de l’ouverture jusqu’à la résolution.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="feature-card h-100">
                        <div class="feature-icon"><i class="bi bi-people-fill"></i></div>
                        <h4>Rôles dédiés</h4>
                        <p>Client, technicien et administrateur disposent chacun d’un accès adapté à leurs responsabilités.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="feature-card h-100">
                        <div class="feature-icon"><i class="bi bi-shield-check"></i></div>
                        <h4>Sécurité</h4>
                        <p>Les comptes sont sécurisés avec des mots de passe hachés et un accès contrôlé.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="py-5">
        <div class="container">
            <div class="row g-4 align-items-center">
                <div class="col-lg-6">
                    <img src="https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&w=900&q=80" alt="Support IT" class="img-fluid rounded-4 shadow-sm">
                </div>
                <div class="col-lg-6">
                    <h2 class="fw-bold mb-4">Une gestion fluide pour votre équipe IT</h2>
                    <ul class="list-unstyled feature-list">
                        <li><i class="bi bi-check-circle-fill text-primary me-2"></i>Créer et suivre les demandes de support</li>
                        <li><i class="bi bi-check-circle-fill text-primary me-2"></i>Attribuer les incidents aux techniciens</li>
                        <li><i class="bi bi-check-circle-fill text-primary me-2"></i>Consulter les performances et les tickets en cours</li>
                        <li><i class="bi bi-check-circle-fill text-primary me-2"></i>Centraliser les échanges avec les clients</li>
                    </ul>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
